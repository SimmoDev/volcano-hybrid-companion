# Copy this file to secrets.yaml alongside it (git-ignored) and fill in
# real values before flashing. `esphome config`/`compile` accept the
# placeholders below unchanged.

# WiFi credentials. The Dial's on-screen UI needs none of this -- WiFi
# here serves the Home page's WiFi status icon, the Connections page's
# WiFi row, the web_server page, and the Home Assistant `api` connection.
wifi_ssid: "your-wifi-ssid"
wifi_password: "your-wifi-password"

# ESPHome native API encryption key, required by the `api:` block (per
# ADR-0012). The value below is an obvious dummy -- 32 bytes of 0x01,
# base64-encoded -- deliberately not a real generated key. It satisfies
# `esphome config`/`compile` (and would technically work on hardware),
# but being committed here it is public: a device flashed with it
# unchanged has an API anyone with this repository can connect to.
# Generate your own with `openssl rand -base64 32` before flashing
# anything on a network you do not fully trust. Home Assistant asks for
# this exact key when it adds the device.
api_encryption_key: "AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE="
