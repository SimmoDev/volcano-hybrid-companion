# Replace with your device's actual static random BLE address (find it by
# scanning for the "S&B VOLCANO H" advertisement -- see
# docs/protocol/gatt-services.md#adv-001--advertising-and-discovery).
volcano_mac_address: "AA:BB:CC:DD:EE:FF"

# Needed only for examples that use web_server (e.g. the command controls in
# esp32-s3-devkit-minimal.yaml) to reach the ESP32-S3 over your local
# network. Not used by the volcano component itself, which is BLE-only.
wifi_ssid: "your-wifi-ssid"
wifi_password: "your-wifi-password"

