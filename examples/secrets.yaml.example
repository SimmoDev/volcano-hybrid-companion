# Replace with your device's actual static random BLE address (find it by
# scanning for the "S&B VOLCANO H" advertisement -- see
# docs/protocol/gatt-services.md#adv-001--advertising-and-discovery).
volcano_mac_address: "AA:BB:CC:DD:EE:FF"

# Needed by both examples: each joins WiFi to serve its web_server page
# and its Home Assistant `api` connection. Not used by the volcano
# component itself, which is BLE-only.
wifi_ssid: "your-wifi-ssid"
wifi_password: "your-wifi-password"

# ESPHome native API encryption key, required by the `api:` block both
# examples declare (per ADR-0012). The value below is an obvious dummy --
# 32 zero bytes, base64-encoded -- deliberately not a real generated key.
# It satisfies `esphome config`/`compile` (and would technically work on
# hardware), but being committed here it is public: a device flashed with
# it unchanged has an API anyone with this repository can connect to.
# Generate your own with `openssl rand -base64 32` before flashing
# anything on a network you do not fully trust. Home Assistant asks for
# this exact key when it adds the device.
api_encryption_key: "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="

